  "codeConnect": {
    "parser": "react",
    "label": "React",
    "include": [
      "src/**/*.figma.ts",
      "src/**/*.tsx"
    ],
    "exclude": [
      "node_modules/**",
      "dist/**"
    ],
    "importPaths": {
