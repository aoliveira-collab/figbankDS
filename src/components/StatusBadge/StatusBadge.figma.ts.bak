// url=https://www.figma.com/design/d4uJBUbsWeFMdQcJWUoPLI/FigBank-Design-System?node-id=10:78
// source=https://github.com/aoliveira-collab/figbankDS/blob/main/src/components/StatusBadge/StatusBadge.tsx
// component=StatusBadge

import figma from "figma"

const label = figma.selectedInstance.getString("Label")
const status = figma.selectedInstance.getEnum("Status", {
  Active: "Active",
  Blocked: "Blocked",
  Virtual: "Virtual",
  Pending: "Pending",
  Info: "Info",
})
const styleVariant = figma.selectedInstance.getEnum("Style", {
  Filled: "Filled",
  Outlined: "Outlined",
})

export default {
  id: "StatusBadge",
  imports: ["import { StatusBadge } from '@figbank/design-system';"],
  example: figma.code`<StatusBadge${figma.helpers.react.renderProp(
    "label",
    label,
  )}${figma.helpers.react.renderProp(
    "status",
    status,
  )}${figma.helpers.react.renderProp("styleVariant", styleVariant)}/>`,
  metadata: { nestable: true },
}
